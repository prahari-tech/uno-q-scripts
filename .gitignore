# The real credentials file. Never commit this.
#
# bin/board.env holds the WiFi passphrase and the board account password in
# plaintext. Only bin/board.env.example, which has empty values, belongs in git.
bin/board.env

# The provisioned board address, written by q-setup. Machine-local.
bin/.board-state
.board-state

# Belt and braces: any other .env anywhere.
.env
*.env
!*.env.example
