# Copy to bin/board.env and fill in. bin/board.env is gitignored and should be
# chmod 600 — this repo is public.
#
#   cp bin/board.env.example bin/board.env && chmod 600 bin/board.env
#
# Any value left unset here is prompted for at run time instead (the passphrase
# is read with `read -s` and never echoed), so filling this in is optional —
# it just makes unattended reruns possible.

# Board name. Sets the mDNS address: <BOARD_NAME>.local
BOARD_NAME=homeguard

# WiFi the board should join. WIFI_PSK is a secret — never commit it.
WIFI_SSID=
WIFI_PSK=

# Public key to install in the board's authorized_keys.
SSH_PUBKEY=~/.ssh/id_ed25519.pub

# Account on the board. Only change this if Arduino ever ships a different one.
BOARD_USER=arduino

# Password for that account. A freshly flashed image leaves it UNSET with a
# forced-change flag, and until it is set sshd authenticates your key and then
# refuses the session ("Password change required but no TTY available") — so
# q-deploy cannot reach the board at all.
#
# Setting it here makes `q-setup all` fully unattended. Leave it empty and the
# passwd step prompts instead, storing nothing. Either way it is only ever
# piped over stdin to Arduino's own arduino-passwd helper, never passed as an
# argument. This is a real password in a plaintext file: keep the file at mode
# 600, and remember it is a dev board on your LAN, not a server.
BOARD_PASSWORD=
